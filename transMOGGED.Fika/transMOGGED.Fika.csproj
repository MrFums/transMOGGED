<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional Fika part: shares looks between players. Only loads when Fika is installed. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>transMOGGED.Fika</AssemblyName>
    <RootNamespace>Transmogged.Fika</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- Don't put this PC's folder path into the built DLL. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>

    <SPTPath Condition="'$(SPTPath)' == ''">E:\Games\SPT4.1-CLEAN</SPTPath>
    <!-- any install that has Fika, it's only needed to build against -->
    <FikaPath Condition="'$(FikaPath)' == ''">E:\Games\SPT4.1\BepInEx\plugins\Fika\Fika.Core.dll</FikaPath>
    <Managed>$(SPTPath)\EscapeFromTarkov_Data\Managed</Managed>
    <BepInExCore>$(SPTPath)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Fika.Core" HintPath="$(FikaPath)" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(Managed)\Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="$(Managed)\Comfort.Unity.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

</Project>
